# Eclipse CDT
.cproject
.project
.settings/
.autotools

# LSP / 索引
.clangd/
.ccls-cache/
.cquery_cached_index/
tags
TAGS
cscope.*
GTAGS
GRTAGS
GPATH

# Sublime / Vim
*.sublime-project
*.sublime-workspace
Session.vim
.netrwhist


# ------------------------------------------------------------
#  16. 操作系统
# ------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Icon?

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*


# ------------------------------------------------------------
#  17. 脚本工具链（若有 Python 构建脚本）
# ------------------------------------------------------------
# 内部依赖构建脚本与清单（二进制交付用，不随源码库发布）
scripts/
__pycache__/
*.py[cod]
.venv/
venv/
.tox/
.mypy_cache/
.pytest_cache/
.ruff_cache/


# ------------------------------------------------------------
#  18. 本地个人覆盖（约定：以 .local 结尾的一律不提交）
# ------------------------------------------------------------
*.local
local.cmake
local.mk
CMakeLists.local.txt
Makefile.local


# ============================================================
#  例外：以下文件必须提交（! 规则必须放在对应忽略规则之后）
# ============================================================
!.gitignore
!.gitattributes
!.gitmodules
!CMakePresets.json
!vcpkg.json
!vcpkg-configuration.json
!**/CMakeLists.txt
!cmake/**/*.cmake       # 你自己写的 FindAPR.cmake / hdnsConfig.cmake.in 等
!**/*.cmake.in
!.github/**
!examples/**/Makefile

# 若需提交预编译的第三方库或测试固件，取消注释并按实际路径调整：
# !third_party/prebuilt/**/*.a
# !third_party/prebuilt/**/*.lib
# !tests/fixtures/**/*.bin
